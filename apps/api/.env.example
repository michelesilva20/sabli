# Copie para apps/api/.env. Não commite o .env.
# A senha JDBC precisa coincidir com SABLI_POSTGRES_PASSWORD.

SABLI_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5435/sabli
SABLI_DATASOURCE_USERNAME=sabli
SABLI_DATASOURCE_PASSWORD=

SABLI_POSTGRES_DB=sabli
SABLI_POSTGRES_USER=sabli
SABLI_POSTGRES_PASSWORD=
SABLI_POSTGRES_PORT=5435

SABLI_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:4175
SABLI_OPENAPI_ENABLED=false
SABLI_JWT_SECRET=
SABLI_COOKIE_SECURE=false
SABLI_REGISTRATION_MODE=BOOTSTRAP_TOKEN
SABLI_BOOTSTRAP_SIGNUP_TOKEN=

# Conta local do npm run dev:seed (senha >= 10). Não use senha de produção.
SABLI_DEV_EMAIL=
SABLI_DEV_PASSWORD=
SABLI_DEV_ORG_SLUG=sabli-dev
SABLI_DEV_EST_SLUG=loja-dev
SABLI_E2E_API=http://127.0.0.1:8080
